# ESP32-S3 + Octal PSRAM（与语音/HTTPS/UI 匹配）
CONFIG_IDF_TARGET="esp32s3"
# 常见 N16R8 模组为 16MB Flash；若板卡为 8MB 可改为 CONFIG_ESPTOOLPY_FLASHSIZE_8MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# Wi-Fi
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# mbedTLS / HTTPS（Full 证书包 + 16K SSL 输入缓冲易占满内部堆，wss 握手 mbedtls_ssl_setup 报 -0x7F00）
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# 让 mbedTLS 动态 buffer 走 PSRAM，避免 WiFi + LCD + WS 并发时内部 DRAM 耗尽
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# 保留 128KB 内部 DRAM 给 lwIP/Wi-Fi/mbedtls 等不能放 SPIRAM 的小对象，防止 DNS/TLS 时 lwIP 堆碎片
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072

# 双 WS（IAT+TTS）并发时 lwIP tcpip 任务栈 3KB 易溢出（DNS+TLS 同时进行）
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144

# 禁止 FreeRTOS 任务栈落到 SPIRAM：S3 上会偶发调度时 PC=NULL 的崩溃（cache 一致性问题）
# CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM is not set

# SNTP：esp_netif 默认配置 2 个 NTP 服务器时须 ≥2
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# esp-sr：与「医疗问答终端配置」里 WAKENET_MODEL_NAME=wn9_hilexin 一致，须勾选才会打入 srmodels.bin
CONFIG_SR_WN_WN9_HILEXIN=y

# 启动默认值须处于 ESP-IDF 5.5.2 允许的 1-60s 范围；app_main 会在运行时重配为 120s
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL：不编译示例/演示以缩短构建时间与固件体积
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
# 中文界面：思源黑体 16px CJK 子集（含常用汉字 + ASCII，默认可显示 Q/A）
CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_16_CJK=y
# 大块静态字模（补充 fallback 字库）需要开启
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# 音量门限触发（默认开）：不依赖唤醒词亦可大声说话开始 ASR
CONFIG_VOICE_ENERGY_FALLBACK=y
CONFIG_VOICE_ENERGY_RMS_MIN=1200

# 讯飞听写：medical 等领域易报 11200(licc)，默认日常用语 iat
CONFIG_XFYUN_IAT_DOMAIN="iat"

# 低延迟：对话模型 + 流式链路（须讯飞 ASR/TTS WebSocket）
CONFIG_DEEPSEEK_MODEL="deepseek-chat"
CONFIG_CHAIN_STREAMING=y

# 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# Public source defaults: no live cloud credentials and no network calls in CI builds.
CONFIG_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_DEEPSEEK_API_KEY=""
CONFIG_CLOUD_ASR_USE_XFYUN_WS=n
CONFIG_CLOUD_TTS_USE_XFYUN_WS=n
CONFIG_CHAIN_STREAMING=n
CONFIG_CLOUD_ASR_URL=""
CONFIG_CLOUD_ASR_TOKEN=""
CONFIG_CLOUD_TTS_URL=""
CONFIG_CLOUD_TTS_TOKEN=""
CONFIG_XFYUN_APP_ID=""
CONFIG_XFYUN_API_KEY=""
CONFIG_XFYUN_API_SECRET=""
